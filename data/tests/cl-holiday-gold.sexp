;; Chile national holidays 2000-2040: external gold for CL.
;; Regenerate: uv run --no-project --with holidays==0.109 python -I scripts/generate_americas_holiday_gold.py CL
;; :days lists every holiday as (YEAR MONTH DAY NAME); any other day is not one.
(
 :country "CL"
 :generated "2026-11-27"
 :from 2000 :to 2040
 :note "Feriados legales of every worker, from the BCN statute texts in :sources. Not included: election and plebiscite days (Ley 18.700 art. 169), which are held on Sundays (two-day votes: Saturday and Sunday) and never change business-day status; the bank-only 31 December (Ley General de Bancos art. 38); and regional days (Arica 7 jun, Chillán 20 ago). The winter solstice date is the civil date in continental Chile (UTC-4 in June) of the June solstice, Meeus ch. 27."
 :sources
 (
  (:title "Ley 2.977 (1915) art. 1" :uri "https://www.bcn.cl/leychile/navegar?idLey=2977"
   :text "Feriados: 1 ene, 29 jun, 15 ago, 1 nov, 8 y 25 dic; viernes y sábado de la Semana Santa; 18 sep; 19 sep y 21 may.")
  (:title "Ley 18.432 (1985)" :uri "https://www.bcn.cl/leychile/navegar?idLey=18432"
   :text "29 de junio feriado legal.")
  (:title "Ley 19.668 (D.O. 2000-03-10)" :uri "https://www.bcn.cl/leychile/navegar?idLey=19668"
   :text "29 jun, 12 oct y (hasta Ley 20.148) Corpus Christi: al lunes de la misma semana si caen martes, miércoles o jueves; al lunes de la semana siguiente si caen viernes.")
  (:title "Ley 19.588 (1998), derogada por Ley 19.793 (D.O. 2002-03-06)" :uri "https://www.bcn.cl/leychile/navegar?idLey=19793"
   :text "Día de la Unidad Nacional, primer lunes de septiembre, 1999-2001.")
  (:title "Ley 17.374 art. 43 (texto Ley 19.790, D.O. 2002-02-01)" :uri "https://www.bcn.cl/leychile/navegar?idNorma=28960"
   :text "El día del censo oficial es feriado legal; la fecha la fija el INE: 2002-04-24, 2017-04-19.")
  (:title "Ley 19.973 art. 1 (D.O. 2004-09-10)" :uri "https://www.bcn.cl/leychile/navegar?idLey=19973"
   :text "Feriado el 17 de septiembre de 2004.")
  (:title "Ley 20.148 (D.O. 2007-01-06)" :uri "https://www.bcn.cl/leychile/navegar?idLey=20148"
   :text "16 de julio, Virgen del Carmen, en reemplazo de Corpus Christi.")
  (:title "Ley 20.215 art. 1 (D.O. 2007-09-14), Código del Trabajo art. 35 ter" :uri "https://www.bcn.cl/leychile/navegar?idLey=20215"
   :text "Si 18 y 19 sep son martes y miércoles, feriado el lunes 17; si miércoles y jueves, el viernes 20.")
  (:title "Ley 20.299 (D.O. 2008-10-11)" :uri "https://www.bcn.cl/leychile/navegar?idLey=20299"
   :text "31 de octubre, Iglesias Evangélicas y Protestantes; si cae martes, al viernes anterior; si cae miércoles, al viernes siguiente.")
  (:title "Ley 20.450 (D.O. 2010-07-19)" :uri "https://www.bcn.cl/leychile/navegar?idLey=20450"
   :text "Feriados el 17 y 20 de septiembre de 2010.")
  (:title "Ley 20.983 (D.O. 2016-12-30)" :uri "https://www.bcn.cl/leychile/navegar?idLey=20983"
   :text "Feriado el viernes 17 sep si 18 y 19 sep son sábado y domingo; el lunes 2 ene si 1 ene es domingo.")
  (:title "Ley 21.357 (D.O. 2021-06-19)" :uri "https://www.bcn.cl/leychile/navegar?idLey=21357"
   :text "Día Nacional de los Pueblos Indígenas: el día del solsticio de invierno (hemisferio sur); 2021: 21 de junio.")
  (:title "Ley 21.482 (D.O. 2022-09-10)" :uri "https://www.bcn.cl/leychile/navegar?idNorma=1181203"
   :text "Feriado nacional el 16 de septiembre de 2022.")
  (:title "Gobierno Digital feriados API 2013-2024 (official; Wayback copies)" :uri "https://apis.digital.gob.cl/fl/feriados"
   :text "Copies: web.archive.org/web/20210617175939id_/https://apis.digital.gob.cl/fl/feriados (2013-2020), .../20210622223224id_/.../fl/feriados/2021, .../20220204200248id_/.../fl/feriados/2022, .../20230209040653id_/.../fl/feriados/2023, .../20240630205227id_/.../fl/feriados/2024. Agree on every day except election days and five listed overrides where the act wins (2018-01-16 RM-only papal visit; 2021-06-21 Ley 21.357; 2022-06-27/28 Ley 19.668; 2022-09-16 Ley 21.482).")
  (:title "feriados.cl 2026-2028 (cross-check)" :uri "https://www.feriados.cl/"
   :text "Lists of 2026, 2027 and 2028 citing BCN; agree with this fixture except election days.")
 )
