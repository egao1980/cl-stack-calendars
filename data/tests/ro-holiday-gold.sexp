;; Romania public holidays 2000-2040: external gold for RO.
;; Regenerate: uv run --no-project --with holidays==0.109 python -I scripts/generate_mena_holiday_gold.py RO
;; :days lists every holiday as (YEAR MONTH DAY NAME); any other day is not one.
(
 :country "RO"
 :generated "2026-11-28"
 :from 2000 :to 2040
 :note "Zile de sărbătoare legală of Romania: Legea 75/1996, Codul muncii art. 134/139 (from 1 Mar 2003) as amended: Rusalii and 15 August from 2009 (L. 202/2008), 30 November from 2012 (L. 147/2012), 24 January and 1 June from 2017 (L. 176/2016, L. 220/2016), Vinerea Mare from 2018 (L. 64/2018), 6 and 7 January from 2024 (L. 52/2023). Orthodox Easter; both Easter and Rusalii Sundays are named."
 :weekends ((nil 6 7))
 :sources
 (
  (:title "Legea nr. 75/1996 pentru stabilirea zilelor de sărbătoare legală în care nu se lucrează" :uri "https://www.cdep.ro/ords/pls/legis/legis_pck.htp_act?ida=8614"
   :text "Art. 1: 1 şi 2 ianuarie; prima şi a doua zi de Paşte; 1 mai; 1 decembrie; 25 şi 26 decembrie.")
  (:title "Legea nr. 53/2003 – Codul muncii, art. 134 (art. 139 after the 2011 republication)" :uri "https://www.cdep.ro/ords/pls/legis/legis_pck.htp_act?ida=41525"
   :text "Art. 134(1): 1 şi 2 ianuarie; prima şi a doua zi de Paşti; 1 mai; 1 decembrie; prima şi a doua zi de Crăciun. In force 1 March 2003 (art. 298).")
  (:title "Legea nr. 202/2008 pentru modificarea alin. (1) al art. 134 din Codul muncii" :uri "https://www.cdep.ro/ords/pls/legis/legis_pck.htp_act?ida=83213"
   :text "Adds 'prima şi a doua zi de Rusalii' and 'Adormirea Maicii Domnului' (15 August): first observed 2009.")
  (:title "Legea nr. 147/2012 pentru modificarea art. 139 alin. (1) din Codul muncii" :uri "https://www.cdep.ro/ords/pls/legis/legis_pck.htp_act?ida=112137"
   :text "Adds '30 noiembrie – Sfântul Apostol Andrei cel Întâi chemat, Ocrotitorul României' (from 2012).")
  (:title "Legea nr. 176/2016 pentru modificarea alin. (1) al art. 139 din Codul muncii" :uri "https://www.cdep.ro/ords/pls/legis/legis_pck.htp_act?ida=139678"
   :text "Adds '24 ianuarie – Ziua Unirii Principatelor Române' (first day off 24 January 2017).")
  (:title "Legea nr. 220/2016 pentru completarea alin. (1) al art. 139 din Codul muncii" :uri "https://www.cdep.ro/ords/pls/legis/legis_pck.htp_act?ida=140450"
   :text "Adds '1 iunie' after '1 mai' (first day off 1 June 2017).")
  (:title "Legea nr. 64/2018 pentru completarea alin. (1) al art. 139 din Codul muncii" :uri "https://www.cdep.ro/ords/pls/legis/legis_pck.htp_act?ida=149963"
   :text "Adds 'Vinerea Mare, ultima zi de vineri înaintea Paștelui' (first 6 April 2018).")
  (:title "Legea nr. 52/2023 pentru completarea alin. (1) al art. 139 din Codul muncii" :uri "https://www.cdep.ro/ords/pls/legis/legis_pck.htp_act?ida=192392"
   :text "Adds '6 ianuarie – Botezul Domnului – Boboteaza' and '7 ianuarie – Soborul Sfântului Proroc Ioan Botezătorul' (first 2024).")
 )
