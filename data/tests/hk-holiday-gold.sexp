;; Hong Kong national holidays 2000-2040: external gold for HK.
;; Regenerate: uv run --no-project --with holidays==0.109 python -I scripts/generate_asia_holiday_gold.py HK
;; :days lists every holiday as (YEAR MONTH DAY NAME); any other day is not one.
(
 :country "HK"
 :generated "2026-11-27"
 :from 2000 :to 2040
 :note "General holidays of Cap. 149 (Schedule (b)-(r) and s. 6(2)), plus the additional days appointed by resolution. Sundays are general holidays but are not listed; a scheduled day that falls on a Sunday is listed on its own date and its substitute too. Lunar dates and Ching Ming are the Hong Kong Observatory's. Checked day by day against the gazetted lists 1999-2027."
 :sources
 (
  (:title "General Holidays Ordinance (Cap. 149), Schedule (replaced 35 of 1998 s. 4; amended 23 of 2011 s. 3)" :uri "https://www.elegislation.gov.hk/hk/cap149"
   :text "(a) every Sunday; (b) the first day of January (or if that day is a Sunday, then the following day); (c)-(e) Lunar New Year's Day, the second and the third day of Lunar New Year (or if that day is a Sunday, then the fourth day of Lunar New Year); (f) Ching Ming Festival (Sunday: the following day); (g) Good Friday; (h) the day following Good Friday; (i) Easter Monday; (j) Labour Day, the first day of May; (k) the Birthday of the Buddha, the eighth day of the fourth lunar month; (l) Tuen Ng Festival; (m) HKSAR Establishment Day, 1 July; (n) National Day, 1 October; (o) the day following the Chinese Mid-Autumn Festival (or if that day is a Sunday, then the second day following that Festival); (p) Chung Yeung Festival; (q) Christmas Day (or if that day is a Sunday, then the second weekday after Christmas Day); (r) the first weekday after Christmas Day. (j)-(n), (p): Sunday gives the following day. Before 23 of 2011, a Sunday among the three Lunar New Year days gave the day preceding Lunar New Year's Day, and a Sunday day-following-Mid-Autumn gave the day of the festival (lists 2002, 2009).")
  (:title "General Holidays Ordinance (Cap. 149) s. 6(2) (replaced 35 of 1998 s. 3)" :uri "https://www.elegislation.gov.hk/hk/cap149"
   :text "Subject to subsection (3), if in any year two general holidays fall on the same day, the next following day that is not itself a general holiday is to be observed as an additional general holiday in that year.")
  (:title "L.N. 191 of 1999; 9 of 2015 s. 2(a) (Cap. 149 editorial notes)" :uri "https://www.elegislation.gov.hk/hk/cap149"
   :text "31 December 1999 appointed an additional general holiday; 3 September 2015 (70th anniversary of the victory of the Chinese people's War of Resistance) a general holiday for 2015.")
  (:title "Hong Kong Observatory, Gregorian-Lunar Calendar Conversion Tables" :uri "https://www.hko.gov.hk/en/gts/time/conversion.htm"
   :text "Lunar months and days, and the 24 solar terms (Ching Ming = 'Bright & Clear'), T1999e.txt-T2041e.txt.")
  (:title "General holidays for 1999-2006 (info.gov.hk, Wayback)" :uri "https://www.info.gov.hk/info/holiday_e.htm"
   :text "The gazetted lists, e.g. 2003: 'As the second day of the Lunar New Year falls on a Sunday, the day preceding the Lunar New Year's Day will be designated as an additional general holiday.'")
  (:title "General holidays for 2007-2027 (gov.hk)" :uri "https://www.gov.hk/en/about/abouthk/holiday/2027.htm"
   :text "The yearly gazetted lists (2007-2026 from Wayback captures, 2027 live).")
  (:title "1823 general holidays calendar (JSON)" :uri "https://www.1823.gov.hk/common/ical/en.json"
   :text "General holidays 2025-2027.")
 )
