(defsystem "cl-stack-calendars"
  :version "0.27.0"
  :description "Holiday and trading calendars for cl-stack (business days, sessions, versioned as-of)"
  :author "egao1980"
  :license "MIT"
  :depends-on ((:version "datetime-protocol" "0.2.0") (:version "datetime-protocol/calendars" "0.2.0") "cl-stack-pathlib")

  :serial t
  :pathname "src"
  :components ((:file "package")
               (:file "conditions")
               (:file "data")
               (:file "protocol")
               (:file "weekends")
               (:file "rules")
               (:file "transfer")
               (:file "gazette")
               (:file "rule-calendar")
               (:file "data-calendar")
               (:file "composite-calendar")
               (:file "versioned-calendar")
               (:file "trading-session")
               (:file "registry")
               (:file "starter-calendars")
               (:file "starter-nyse")
               (:file "starter-russian")
               (:file "starter-japan")
               (:file "starter-china")
               (:file "starter-india")
               (:file "starter-eu")
               (:file "starter-asia")
               (:file "starter-thailand")
               (:file "starter-south-asia")
               (:file "starter-americas")
               (:file "starter-africa")
               (:file "starter-mena")
               (:file "starter-small")
               (:file "coverage")
               (:file "country-calendar")
               (:file "corpus-inference")
               (:file "starter-territories")
               (:file "starter-subnational")
               (:file "exchange-hours"))
  :in-order-to ((test-op (test-op "cl-stack-calendars/tests"))))

(defsystem "cl-stack-calendars/tests"
  :depends-on ("cl-stack-calendars" "cl-stack-tzdata" "rove")
  :pathname "tests"
  :serial t
  :components ((:file "package")
               (:file "business-day-test")
               (:file "russian-calendar-test")
               (:file "russian-production-gold-test")
               (:file "americas-holiday-gold-test")
               (:file "asia-holiday-gold-test")
               (:file "normative-calendar-test")
               (:file "country-calendar-test")
               (:file "holiday-suite-test")
               (:file "observance-order-test")
               (:file "hijri-occurrence-test")
               (:file "composite-semantics-test")
               (:file "weekend-eras-test")
               (:file "year-map-cache-test")
               (:file "coverage-test")
               (:file "robustness-test")
               (:file "external-gold-test")
               (:file "registry-data-years-test")
               (:file "corpus-derived-test")
               (:file "calc-gold-test")
               (:file "lunisolar-festival-test")
               (:file "trading-session-test")
               (:file "exchange-hours-test")
               (:file "xnys-gold-test")
               (:file "data-root-test"))
  :perform (test-op (o c)
                    (unless (symbol-call :rove :run c)
                      (error "tests failed for ~A" (component-name c)))))
