 (:calendar "ZW" :key "act-ch10-21" :from (1969 3 14) :to nil
  :authority "Public Holidays and Prohibition of Business Act [Chapter 10:21] (Act 19 of 1969, consolidated to 31 December 2016)"
  :uri "https://web.archive.org/web/20260417054800id_/https://zimlii.org/akn/zw/act/1969/19/eng@2016-12-31"
  :issued (1969 3 14) :issued-uri "https://zimlii.org/akn/zw/act/1969/19/eng@2016-12-31" :published nil :published-in "ZimLII consolidation dated 2016-12-31 (commenced 14 March 1969)" :in-force (1969 3 14) :dates-note "The 1969 Rhodesian Gazette issue was not located; 14 March 1969 is the commencement date ZimLII gives." :summary "s.2(1): the Schedule days are public holidays, provided (i) when a public holiday falls on a Sunday the following Monday is a public holiday, and (ii) when 26 December falls on a Monday the following Tuesday is a public holiday. s.2(2): the President may by statutory instrument declare any day a public holiday. Schedule: New Year's Day; Independence Day 18 April; Good Friday; the Saturday between Good Friday and Easter Sunday; Easter Monday; Worker's Day 1 May; Africa Day 25 May; the second Monday in August and the day following (Heroes' Day, Defence Forces National Day) [para substituted by Act 17 of 2001]; National Unity Day 22 December [para substituted by Act 17 of 2001]; Christmas Day and the day following. Easter Sunday is NOT in the Schedule but the Minister's annual lists include it from 2009. No Saturday rule.")
 (:calendar "ZW" :key "act-17-2001" :from nil :to nil
  :authority "Public Holidays and Prohibition of Business Amendment Act, 2001 (Act 17 of 2001)"
  :uri "https://web.archive.org/web/20260417054800id_/https://zimlii.org/akn/zw/act/1969/19/eng@2016-12-31"
  :issued nil :published nil :in-force nil :dates-note "Known only from the amendment notes in the ZimLII consolidation; the Act text and its date were not located." :summary "Substituted Schedule para 8 (Heroes' Day = second Monday in August, Defence Forces National Day = the day following) and para 9 (National Unity Day 22 December). Before it, Heroes' Day and Defence Forces Day were 11 and 12 August (secondary sources only; not verified against the pre-2001 text). The 2004 list (GN 137/2004) already says 'Monday 9th August, the second Monday in August'.")
 (:calendar "ZW" :key "electoral-act-s38" :from nil :to nil
  :authority "Electoral Act [Chapter 2:13] (Act 25 of 2004), s.38(2)"
  :uri "https://zimlii.org/akn/zw/act/2004/25/eng@2016-12-31"
  :issued nil :published nil :published-in "ZimLII consolidation dated 2016-12-31" :in-force nil :dates-note "Read through the ZimLII search snippet and the Veritas Election Watch 23/2023 summary only; the 2004 Act's gazette date was not looked up." :summary "Polling days in a general election are deemed public holidays for the purposes of the Public Holidays and Prohibition of Business Act. The Minister still gazettes a notice (e.g. GN 1345A/2023).")
 (:calendar "ZW" :key "si-143-2017" :from (2017 11 24) :to nil
