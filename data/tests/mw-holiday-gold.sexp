;; Regenerate: uv run --no-project --with holidays==0.109 python -I scripts/generate_mena_holiday_gold.py MW
;; :days lists every holiday as (YEAR MONTH DAY NAME); any other day is not one.
(
 :country "MW"
 :generated "2026-11-28"
 :from 2000 :to 2040
 :note "LOWER CONFIDENCE. Public holidays of Malawi: the Public Holidays Act (Cap. 18:05) Schedule (Kamuzu Day 14 May from 2007, Mother's Day 15 October, John Chilembwe Day 15 January, Boxing Day from 2012, Easter Saturday) with s. 4: a Saturday or Sunday holiday ceases and the next day that is not a Sunday or holiday is one; Eid al-Fitr at the declared day, from news reports of the Government statements (2013, 2016, 2017, 2019, 2020, 2023, 2024, 2026). Other years: tabular Eid al-Fitr."
 :confidence :secondary
 :weekends ((nil 6 7))
 :sources
 (
  (:title "Public Holidays Act, Chapter 18:05 (Act 11 of 1967), revised and consolidated to 31 December 2014 (L.R.O. 1/2015)" :uri "https://web.archive.org/web/20211202034241id_/https://malawilii.org/akn/mw/act/1967/11/eng@2014-12-31"
   :text "s.2 Schedule days are public holidays. s.3(1) the Minister may amend the Schedule by Gazette order; s.3(2) may declare any day a public holiday (in addition or in substitution, nationally or locally). s.4 [16 of 1983]: where a Schedule day other than the Saturday following Good Friday falls on a Saturday or Sunday, the next succeeding day not being itself a Sunday or public holiday is the public holiday and the Schedule day ceases to be one. Schedule (as amended by G.N. 99/1986, 67/1994, 84/1994, 76/1997, 41/2007): New Year's Day; John Chilembwe Day (15 January); Martyrs' Day (3 March); Good Friday; Saturday following Good Friday; Easter Monday; Labour Day (1 May); Kamuzu Day (14 May); Independence Day (6 July); Mothers' Day (15 October); Eid al Fitri; Christmas Day. NO Boxing Day in the Schedule.")
  (:title "Ministry of Local Government statement reinstating Boxing Day (26 December) as a public holiday from 2012" :uri "https://www.nyasatimes.com/?p=36767"
   :text "Joyce Banda's administration restored Boxing Day, which the Bingu wa Mutharika government had delisted, 'effective this year' (2012).")
  (:title "Nyasa Times: Malawi declares Friday Muslim Eid-el-Fitri festival holiday (2013)" :uri "https://www.nyasatimes.com/?p=54612"
