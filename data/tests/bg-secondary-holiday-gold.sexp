 :sources
 (
  (:title "Кодекс на труда, чл. 154 (официални празници)" :uri "https://lex.bg/laws/ldoc/1594373121"
   :text "(1) 1 януари, 3 март, 1 май, 6 май, 24 май, 6 септември, 22 септември, 1 ноември (неприсъствен за всички учебни заведения), 24 декември, 25 и 26 декември, Велики петък, Велика събота и Великден - неделя и понеделник.")
  (:title "Закон за изменение и допълнение на Кодекса на труда (ДВ бр. 15 от 23.02.2010), § 7" :uri "https://dv.parliament.bg/DVWeb/showMaterialDV.jsp?idMat=29936"
   :text "§ 7: 'Великден - два дни (неделя и понеделник)' replaced by 'Велики петък, Велика събота и Великден - неделя и понеделник'.")
  (:title "Закон за изменение и допълнение на Кодекса на труда (ДВ бр. 105 от 30.12.2016), § 6" :uri "https://dv.parliament.bg/DVWeb/showMaterialDV.jsp?idMat=110584"
   :text "Чл. 154(2): Когато официалните празници по ал. 1, с изключение на Великденските празници, съвпадат със събота и/или неделя, първият или първите два работни дни след тях са неприсъствени. (3): the Council of Ministers may declare one-off days only.")
 )
