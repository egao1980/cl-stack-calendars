;; Slovenia public holidays 2000-2040: external gold for SI.
;; Regenerate: uv run --no-project --with holidays==0.109 python -I scripts/generate_mena_holiday_gold.py SI
;; :days lists every holiday as (YEAR MONTH DAY NAME); any other day is not one.
(
 :country "SI"
 :generated "2026-11-28"
 :from 2000 :to 2040
 :note "Dela prosti dnevi of Slovenia: ZPDPD-UPB1 čl. 1-2 (Easter Sunday and Monday, Whit Sunday included); 2 January not a day off 2013-2016 (ZUJF art. 82; restored by ZPDPD-D); 14 August 2023 (ZOPNN-F art. 15). Prazniki that are not days off are left out. No Sunday move."
 :weekends ((nil 6 7))
 :sources
 (
  (:title "Zakon o praznikih in dela prostih dnevih v Republiki Sloveniji, uradno prečiščeno besedilo (ZPDPD-UPB1)" :uri "https://pisrs.si/api/uradni-list/objava/u2005112.pdf"
   :text "Čl. 1: 1. in 2. januar, 8. februar, 27. april, 1. in 2. maj, 25. junij, 1. november, 26. december are dela prosti dnevi (17 Aug, 15 Sep, 23 Nov are not). Čl. 2: also velikonočna nedelja in ponedeljek, binkoštna nedelja, 15. avgust, 31. oktober, 25. december.")
  (:title "Zakon za uravnoteženje javnih financ (ZUJF), 82. člen" :uri "https://pisrs.si/api/uradni-list/objava/u2012040.pdf"
   :text "82. člen: the first indent of čl. 1 ZPDPD becomes »– 1. januar, novo leto« (2 January no longer a day off, first affected 2 Jan 2013).")
  (:title "Zakon o spremembah Zakona o praznikih in dela prostih dnevih v Republiki Sloveniji (ZPDPD-D)" :uri "https://pisrs.si/api/uradni-list/objava/u2016083.pdf"
   :text "1. člen: »– 1. in 2. januar, novo leto« (2 January a day off again from 2017).")
  (:title "Zakon o interventnih ukrepih za odpravo posledic poplav in zemeljskih plazov iz avgusta 2023 (ZOPNN-F), 15. člen" :uri "https://pisrs.si/api/uradni-list/objava/u2023088.pdf"
   :text "15. člen: se v letu 2023 kot dela prost dan v Republiki Sloveniji določi 14. avgust (dan solidarnosti).")
 )
