;; Regenerate: uv run --no-project --with holidays==0.109 python -I scripts/generate_mena_holiday_gold.py HU
;; :days lists every holiday as (YEAR MONTH DAY NAME); any other day is not one.
(
 :country "HU"
 :generated "2026-11-28"
 :from 2000 :to 2040
 :note "Munkaszüneti napok of Hungary: 1992. évi XXII. tv. § 125 (3), Mt. 2012 § 102 (1), Nagypéntek from 2017, Szenteste from 14 Nov 2026 (2026. évi LXXII. tv.); every yearly munkarend decree 2001-2026 (rest days as holidays, the Saturdays as working days). Easter and Whit Sunday are not munkaszüneti napok. 2027-2040 are provisional: the statutory days only."
 :weekends ((nil 6 7))
