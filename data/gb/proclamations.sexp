;;;; England & Wales special Royal Proclamations under BFDA 1971 s.1(2)–(3).
;;;; EXTRA = one-off bank holidays; MOVED = (from to) where FROM is suppressed
;;;; (statutory rule day cancelled) and TO is the appointed substitute/relocation.
;;;; Ordinary weekend substitutes are handled by :uk-proclamation-substitute rules.
;;;;
;;;; Coverage: VE Day moves, Jubilees, Coronation, Royal Wedding 2011.

(
 (:year 2023
  :authority "Royal Proclamation — Coronation bank holiday (BFDA 1971 s.1(3))"
  :uri "https://www.gov.uk/bank-holidays"
  :extra (
           ((2023 5 8) "Coronation of King Charles III")
           )
  :moved (
           ))

 (:year 2022
  :authority "Royal Proclamation — Platinum Jubilee (BFDA 1971 s.1(2)–(3))"
  :uri "https://en.wikipedia.org/wiki/Public_holidays_in_the_United_Kingdom"
  :extra (
           ((2022 6 3) "Platinum Jubilee bank holiday")
           )
  :moved (
           ((2022 5 30) (2022 6 2) "Spring Bank Holiday relocated for Platinum Jubilee")
           ))

 (:year 2020
  :authority "Royal Proclamation — VE Day 75th anniversary (BFDA 1971 s.1(2))"
  :uri "https://commonslibrary.parliament.uk/bank-holidays-how-are-they-created-and-changed/"
  :extra (
           )
  :moved (
           ((2020 5 4) (2020 5 8) "Early May Bank Holiday relocated for VE Day 75")
           ))

 (:year 2012
  :authority "Royal Proclamation — Diamond Jubilee (BFDA 1971 s.1(2)–(3))"
  :uri "https://en.wikipedia.org/wiki/Public_holidays_in_the_United_Kingdom"
  :extra (
           ((2012 6 5) "Diamond Jubilee bank holiday")
           )
  :moved (
           ((2012 5 28) (2012 6 4) "Spring Bank Holiday relocated for Diamond Jubilee")
           ))

 (:year 2011
  :authority "Royal Proclamation 15 Dec 2010 — Royal Wedding (BFDA 1971 s.1(3))"
  :uri "https://www.thegazette.co.uk/notice/E-26880-2"
  :extra (
           ((2011 4 29) "Royal Wedding bank holiday")
           )
  :moved (
           ))

 (:year 2002
  :authority "Royal Proclamation — Golden Jubilee (BFDA 1971 s.1(2)–(3))"
  :uri "https://en.wikipedia.org/wiki/Public_holidays_in_the_United_Kingdom"
  :extra (
           ((2002 6 3) "Golden Jubilee bank holiday")
           )
  :moved (
           ((2002 5 27) (2002 6 4) "Spring Bank Holiday relocated for Golden Jubilee")
           ))

 (:year 1995
  :authority "Royal Proclamation — VE Day 50th anniversary (BFDA 1971 s.1(2))"
  :uri "https://commonslibrary.parliament.uk/bank-holidays-how-are-they-created-and-changed/"
  :extra (
