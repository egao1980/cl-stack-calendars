   :text "")
  (:title "Nyasa Times: Malawi observes Eid-ul-Fitr holiday Wednesday (2019)" :uri "https://www.nyasatimes.com/?p=164098"
   :text "")
  (:title "Nyasa Times: Malawi holiday to celebrate Eid-ul-Fitr Monday (2020)" :uri "https://www.nyasatimes.com/?p=180784"
