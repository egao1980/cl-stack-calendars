;; Zambia (secondary sources) public holidays 2000-2026: external gold for ZM.
;; Regenerate: uv run --no-project --with holidays==0.109 python -I scripts/generate_mena_holiday_gold.py ZM-SECONDARY
;; :days lists every holiday as (YEAR MONTH DAY NAME); any other day is not one.
(
 :country "ZM"
 :generated "2026-11-28"
 :from 2000 :to 2026
 :note "LOWER CONFIDENCE. 2026: SI 73/2026 (Prayer Day withdrawn, 29 December added) and the election days from news reports; 2000-2012: statute days only."
 :gaps (2013 2014 2015 2016 2017 2018 2019 2020 2021 2022 2023 2024 2025)
 :confidence :secondary
 :weekends ((nil 6 7))
 :sources
 (
  (:title "Public Holidays Act, Chapter 272 of the Laws of Zambia (Act 14 of 1964, as amended to Act 23 of 1987; 1996 revised edition)" :uri "https://www.parliament.gov.zm/sites/default/files/documents/acts/Public%20Holidays%20Act.pdf"
   :text "s.2(1) Schedule days are public holidays; s.2(2) whenever a Schedule day falls on a Sunday the following Monday is observed as a public holiday; s.3 the Minister may by statutory notice declare additional days. Schedule: (a) New Year's Day (b) Youth Day (12th March) (c) Good Friday (d) Holy Saturday (e) Labour Day (1st May) (f) African Freedom Day (25th May) (g) Heroes Day (First Monday in July) (h) Unity Day (Tuesday following Heroes Day) (i) Farmers Day (First Monday in August) (j) Independence Day (24th October) (k) Christmas Day. Easter Sunday, Easter Monday, Women's Day, Prayer Day and Kenneth Kaunda Day are s.3 days (NAB 76/2026 committee report), but the Cabinet Office lists apply the Sunday rule to them too (2020-03-09, 2020-10-19, 2024-04-29, 2026-03-09).")
  (:title "Public Holidays (Amendment) Act, 1983 (Act 12 of 1983)" :uri "https://zambialii.org/akn/zm/act/1983/12/eng@1983-04-15"
   :text "Substituted the Schedule: Youth Day = third Saturday in March; Heroes Day = first Monday in July; Unity Day = Tuesday following Heroes Day; Farmers Day = first Monday in August; Good Friday, Holy Saturday, Labour Day, Africa Freedom Day, Independence Day, Christmas Day.")
  (:title "Public Holidays (Amendment) Act, 1987 (Act 23 of 1987)" :uri "https://zambialii.org/akn/zm/act/1987/23/eng@1987-12-31"
   :text "Replaced para (b) with Youth Day (12th March), in force for 1988 on.")
  (:title "Public Holiday (Declaration) Notice, 2007 (SI 33 of 2007)" :uri "https://zambialii.org/akn/zm/act/si/2007/33/eng@2007-04-27"
   :text "(Secondary) declares 8 March, International Women's Day, a public holiday every year from 2008. The Cabinet Office lists include it from 2013 (first list seen).")
  (:title "Public Holiday (Declaration) Notice, 2015 (SI 78 of 2015)" :uri "https://zambialii.org/akn/zm/act/si/2015/78/eng@2015-10-23"
   :text "'declared that the 18th of October in every year, commencing with 18th October, 2016, shall be observed as a public holiday, being a day of national prayer, fasting, repentance [and reconciliation]'. Revoked in 2026 (si-73-2026).")
  (:title "Constitution of Zambia (Amendment) Act, 2016 (Act 2 of 2016), Article 56" :uri "https://zambialii.org/akn/zm/act/1991/1/eng@2025-12-18"
   :text "Art. 56(1) general elections every five years on the second Thursday of August; Art. 56(2) 'The day on which a general election is held shall be a public holiday.' (2016-08-11, 2021-08-12, 2026-08-13).")
  (:title "Public Holidays (Declaration) (No. 3) Notice, 2021 (SI 72 of 2021)" :uri "https://zambialii.org/akn/zm/act/si/2021/72/eng@2021-08-20"
   :text "'It is declared that 28th April in every year, commencing with 28th April, 2022, shall be observed as a public holiday in commemoration of the birthday of the late First [Republican President Dr Kenneth David Kaunda]'.")
  (:title "Statutory Instrument No. 73 of 2026 (National Day of Prayer and Christian Heritage); revocation of SI 78 of 2015" :uri "https://www.lusakatimes.com/2026/10/09/govt-cancels-october-18-as-public-holiday/"
   :text "Revokes SI 78/2015, so 18 October 2026 (and the Monday 19 Oct in lieu) is not a holiday; makes 29 December every year, from 2026, the National Day of Prayer and Christian Heritage.")
  (:title "Gazette Notice No. 537 of 2012, The Public Holidays Act: Public Holidays in the year 2013 (2013)" :uri "https://archive.gazettes.africa/archive/zm/2012/zm-government-gazette-dated-2012-08-31-no-6100.pdf"
   :text "")
