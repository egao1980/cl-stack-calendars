;; Philippines national holidays 2000-2040: external gold for PH.
;; Regenerate: uv run --no-project --with holidays==0.109 python -I scripts/generate_asia_holiday_gold.py PH
;; :days lists every holiday as (YEAR MONTH DAY NAME); any other day is not one.
(
 :country "PH"
 :generated "2026-11-27"
 :from 2000 :to 2040
 :note "Regular holidays and nationwide special (non-working) days, as the proclamations of each year 2000-2027 set them (moved days on their new date; nationwide ad-hoc days such as election days included; special working days, regional days and schools-only days left out). Eid'l Fitr and Eid'l Adha 2027 and every year from 2028 are provisional: the statutory days only, with the Eid days estimated by the tabular Islamic calendar."
 :sources
 (
  (:title "Executive Order No. 292 (Administrative Code of 1987), Book I, Chapter 7, Sec. 26, as amended by RA 9492 (2007)" :uri "https://lawphil.net/statutes/repacts/ra2007/ra_9492_2007.html"
   :text "(1) Regular Holidays: New Year's Day (January 1), Maundy Thursday, Good Friday, Eidul Fitr (movable), Araw ng Kagitingan (April 9), Labor Day (May 1), Independence Day (June 12), National Heroes Day (last Monday of August), Bonifacio Day (November 30), Christmas Day (December 25), Rizal Day (December 30); (2) Nationwide Special Holidays: Ninoy Aquino Day (August 21), All Saints Day (November 1), Last Day of the Year (December 31). Holidays other than Christmas, New Year's, Maundy Thursday, Good Friday and Eidul Fitr may be moved to the nearest Monday by proclamation.")
  (:title "Republic Act No. 9177 (2002); RA 9256 (2004); RA 9849 (2009); RA 10966 (2017)" :uri "https://lawphil.net/statutes/repacts/ra2009/ra_9849_2009.html"
   :text "RA 9177: Eidul Fitr a regular holiday. RA 9256: Ninoy Aquino Day, 21 August. RA 9849: Eidul Adha a regular holiday. RA 10966: 8 December, Feast of the Immaculate Conception, special non-working.")
  (:title "Yearly proclamations on regular holidays and special (non-working) days, Eid'l Fitr and Eid'l Adha, 2000-2027 (lawphil.net)" :uri "https://lawphil.net/executive/proc/proc2026/proc2026.html"
   :text "E.g. Proc. 368 s.2023 (2024 days), Proc. 665 s.2024 (Ninoy Aquino Day 2024 to 23 August), Proc. 727 s.2024 (2025; EDSA a special working day), Proc. 1427 s.2026 (2027; EDSA a special working day). Each year's numbers are in PH_PROCLAMATIONS of the generator.")
  (:title "Official Gazette (Wayback copies)" :uri "https://www.officialgazette.gov.ph/"
   :text "Proc. 556 s.2018 (Eid'l Adha 2018-08-21).")
 )
