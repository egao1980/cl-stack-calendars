;; Regenerate: uv run --no-project --with holidays==0.109 python -I scripts/generate_mena_holiday_gold.py HR
;; :days lists every holiday as (YEAR MONTH DAY NAME); any other day is not one.
(
 :country "HR"
 :generated "2026-11-28"
 :from 2000 :to 2040
 :note "Blagdani i neradni dani of Croatia: NN 33/1996, NN 96/2001 (from 15 Nov 2001: 25 June Dan državnosti, 8 October Dan neovisnosti, Tijelovo; no 6 January), NN 13/2002 (6 January again from 16 Feb 2002), NN 55/2008 (Uskrs named) and NN 110/2019 (from 2020: 30 May, 18 November; 25 June and 8 October memorial days). No Sunday move."
 :weekends ((nil 6 7))
 :sources
 (
  (:title "Zakon o blagdanima, spomendanu i neradnim danima u Republici Hrvatskoj" :uri "https://narodne-novine.nn.hr/clanci/sluzbeni/1996_04_33_674.html"
   :text "Čl. 1: 1. siječnja, 6. siječnja, Uskrsni ponedjeljak, 1. svibnja, 30. svibnja (Dan državnosti), 22. lipnja, 5. kolovoza, 15. kolovoza, 1. studenog, 25. i 26. prosinca. U dane blagdana ne radi se.")
  (:title "Zakon o izmjenama i dopuni Zakona o blagdanima, spomendanu i neradnim danima" :uri "https://narodne-novine.nn.hr/clanci/sluzbeni/2001_11_96_1614.html"
   :text "Čl. 2 rewrites čl. 1: adds Tijelovo, 25. lipnja Dan državnosti, 8. listopada Dan neovisnosti; 30 May and 6 January are not in the new list.")
  (:title "Zakon o dopuni Zakona o blagdanima, spomendanima i neradnim danima" :uri "https://narodne-novine.nn.hr/clanci/sluzbeni/2002_02_13_318.html"
   :text "Čl. 1 inserts: 6. siječnja – Bogojavljenje ili Sveta tri kralja.")
  (:title "Zakon o izmjenama i dopunama Zakona o blagdanima, spomendanima i neradnim danima" :uri "https://narodne-novine.nn.hr/clanci/sluzbeni/2008_05_55_1911.html"
   :text "Čl. 1: »Uskrs i Uskrsni ponedjeljak«; 25. prosinca Božić; 26. prosinca Sveti Stjepan.")
  (:title "Zakon o blagdanima, spomendanima i neradnim danima u Republici Hrvatskoj" :uri "https://narodne-novine.nn.hr/clanci/sluzbeni/2019_11_110_2212.html"
   :text "Čl. 1(1): 1. i 6. siječnja, Uskrs i Uskrsni ponedjeljak, Tijelovo, 1. svibnja, 30. svibnja Dan državnosti, 22. lipnja, 5. kolovoza, 15. kolovoza, 1. studenoga, 18. studenoga, 25. i 26. prosinca. 25 June and 8 October become spomendani (čl. 2). Čl. 8: in force 1 January 2020.")
