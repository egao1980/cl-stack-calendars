;; Ireland public holidays 2000-2040: external gold for IE.
;; Regenerate: uv run --no-project --with holidays==0.109 python -I scripts/generate_mena_holiday_gold.py IE
;; :days lists every holiday as (YEAR MONTH DAY NAME); any other day is not one.
(
 :country "IE"
 :generated "2026-11-28"
 :from 2000 :to 2040
 :note "Public holidays of Ireland: Organisation of Working Time Act 1997 Sched. 2 para. 1 (in force 30 Sep 1997) and the days prescribed under para. 1(g): 14 September 2001 (S.I. 419/2001), 18 March 2022 and St Brigid's Day from 2023 (first Monday of February, or 1 February when a Friday; S.I. 50/2022). No substitute day for a weekend holiday (s. 21 is an entitlement)."
 :weekends ((nil 6 7))
 :sources
 (
  (:title "Organisation of Working Time Act 1997 (No. 20 of 1997), Second Schedule" :uri "https://www.irishstatutebook.ie/eli/1997/act/20/schedule/2/enacted/en/html"
   :text "Para. 1: public holidays are (a) Christmas Day (b) St. Stephen's Day (c) St. Patrick's Day (d) Easter Monday, the first Monday in May, June and August (e) the last Monday in October (f) 1 January (g) any other day prescribed. Eras before 1997 (Holidays (Employees) Act 1973) are the starter's and were not researched.")
  (:title "S.I. No. 10/1999, Organisation of Working Time (Public Holiday) Regulations, 1999" :uri "https://www.irishstatutebook.ie/eli/1999/si/10/made/en/html"
   :text "31 December 1999 is prescribed for Sched. 2 para. 1.")
  (:title "S.I. No. 419/2001, Organisation of Working Time (National Day of Mourning) Regulations, 2001" :uri "https://www.irishstatutebook.ie/eli/2001/si/419/made/en/html"
   :text "Reg. 2: the 14th day of September, 2001, is prescribed for Sched. 2 para. 1 (National Day of Mourning after the attacks of 11 September 2001).")
  (:title "S.I. No. 50/2022, Organisation of Working Time (Covid-19 Commemoration) Regulations 2022" :uri "https://www.irishstatutebook.ie/eli/2022/si/50/made/en/html"
   :text "Reg. 3: 18 March 2022 is prescribed. Regs. 4-5: the first Monday in February from 2023, or 1 February when it falls on a Friday (St Brigid's Day).")
 )
