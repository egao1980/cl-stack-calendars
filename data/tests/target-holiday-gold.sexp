;; TARGET (euro RTGS) public holidays 1999-2040: external gold for TARGET.
;; Regenerate: uv run --no-project --with holidays==0.109 python -I scripts/generate_mena_holiday_gold.py TARGET
;; :days lists every holiday as (YEAR MONTH DAY NAME); any other day is not one.
(
 :country "TARGET"
 :generated "2026-11-28"
 :from 1999 :to 2040
 :note "TARGET closing days: 1999 25 December and New Year's Day; 2000-2001 New Year's Day, Good Friday, Easter Monday, 1 May, 25 and 26 December (ECB press releases 15 Jul 1999, 25 May 2000); from 2002 the long-term calendar of 14 Dec 2000 (the same six days); plus 31 December 1999 (Y2K, 31 Mar 1999) and 31 December 2001 (euro cash changeover, 25 May 2000)."
 :weekends ((nil 6 7))
 :sources
 (
  (:title "Year 2000 - Closing of TARGET on 31 December 1999" :uri "https://www.ecb.europa.eu/press/pr/date/1999/html/pr990331.en.html"
   :text "TARGET (Interlinking and all domestic euro RTGS systems) closed on 31 December 1999.")
  (:title "TARGET closing days in 2000" :uri "https://www.ecb.europa.eu/press/pr/date/1999/html/pr990715_1.en.html"
   :text "1999: closed on Saturdays, Sundays, Christmas Day and New Year's Day (and 31 December 1999). 2000: closed on New Year's Day, Good Friday, Easter Monday, 1 May, Christmas Day and 26 December.")
  (:title "TARGET closing days in 2001" :uri "https://www.ecb.europa.eu/press/pr/date/2000/html/pr000525_2.en.html"
   :text "2001: the 2000 calendar plus 31 December, to safeguard the conversion of retail payment systems and internal bank systems to the euro.")
  (:title "Long-term calendar for TARGET closing days" :uri "https://www.ecb.europa.eu/press/pr/date/2000/html/pr001214_4.en.html"
   :text "From 2002 until further notice: closed, besides Saturdays and Sundays, on New Year's Day, Good Friday, Easter Monday, 1 May, Christmas Day and 26 December.")
 )
