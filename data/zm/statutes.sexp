 (:calendar "ZM" :key "cap-272" :from (1964 3 26) :to nil
  :authority "Public Holidays Act, Chapter 272 of the Laws of Zambia (Act 14 of 1964, as amended to Act 23 of 1987; 1996 revised edition)"
  :uri "https://www.parliament.gov.zm/sites/default/files/documents/acts/Public%20Holidays%20Act.pdf"
