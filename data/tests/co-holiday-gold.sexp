;; Colombia national holidays 2000-2040: external gold for CO.
;; Regenerate: uv run --no-project --with holidays==0.109 python -I scripts/generate_americas_holiday_gold.py CO
;; :days lists every holiday as (YEAR MONTH DAY NAME); any other day is not one.
(
 :country "CO"
 :generated "2026-11-27"
 :from 2000 :to 2040
 :note "Colombia publishes no official machine-readable festivos list (none on datos.gov.co); the days are the statute texts in :sources applied to each year. Easter Sunday is not a festivo."
 :sources
 (
  (:title "Ley 51 de 1983 (Ley Emiliani) art. 1" :uri "https://www.funcionpublica.gov.co/eva/gestornormativo/norma.php?i=4954"
   :text "Festivos: 1 ene, 6 ene, 19 mar, 1 may, 29 jun, 20 jul, 7 ago, 15 ago, 12 oct, 1 nov, 11 nov, 8 dic, 25 dic, Jueves y Viernes Santos, Ascensión, Corpus Christi, Sagrado Corazón. Inciso 2: 6 ene, 19 mar, 29 jun, 15 ago, 12 oct, 1 nov, 11 nov, Ascensión, Corpus Christi y Sagrado Corazón, cuando no caigan en lunes, se trasladan al lunes siguiente.")
  (:title "Ley 2578 de 2026 art. 6 (D.O. 53.510, 2 jun 2026)" :uri "http://www.secretariasenado.gov.co/senado/basedoc/ley_2578_2026.html"
   :text "Día de Nuestra Señora del Rosario de Chiquinquirá, 9 de julio, festivo nacional; se aplica la Ley 51 de 1983 (traslado al lunes). Rige desde su promulgación.")
 )
