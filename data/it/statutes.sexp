 (:calendar "IT" :key "l-54-1977" :from (1977 3 7) :to nil
  :authority "Legge 5 marzo 1977, n. 54, Disposizioni in materia di giorni festivi"
  :uri "https://www.normattiva.it/uri-res/N2Ls?urn:nir:stato:legge:1977-03-05;54"
  :issued (1977 3 5) :issued-uri "https://www.normattiva.it/uri-res/N2Ls?urn:nir:stato:legge:1977-03-05;54" :published (1977 3 7) :published-uri "https://www.normattiva.it/uri-res/N2Ls?urn:nir:stato:legge:1977-03-05;54" :published-in "GU n. 63 del 07-03-1977" :in-force nil :dates-note "Normattiva states no entry into force; :FROM is the GU date." :summary "Art. 1: Epifania, San Giuseppe, Ascensione, Corpus Domini, SS. Pietro e Paolo cease to be festivi agli effetti civili; from 1977 the festa nazionale della Repubblica and the festa dell'Unità nazionale are celebrated on the first Sunday of June and of November; 2 giugno and 4 novembre cease to be festivi.")
