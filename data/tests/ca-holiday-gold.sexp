;; Canada (federal) national holidays 2000-2040: external gold for CA.
;; Regenerate: uv run --no-project --with holidays==0.109 python -I scripts/generate_americas_holiday_gold.py CA
;; :days lists every holiday as (YEAR MONTH DAY NAME); any other day is not one.
(
 :country "CA"
 :generated "2026-11-27"
 :from 2000 :to 2040
 :note "Federal scope: the general holidays of the Canada Labour Code (federally regulated employers), with the Holidays Act dates. Provincial holidays (Family Day, Civic Holiday, Easter Monday, Saint-Jean-Baptiste, ...) are not federal and are not here; the days every province also observes are New Year's Day, Good Friday, Canada Day, Labour Day and Christmas Day. No official machine-readable list exists; the days are the statute texts (Justice Laws XML) applied to each year."
 :sources
 (
  (:title "Canada Labour Code (R.S.C. 1985, c. L-2) s. 166, \"general holiday\"" :uri "https://laws-lois.justice.gc.ca/eng/acts/L-2/"
   :text "New Year's Day, Good Friday, Victoria Day, Canada Day, Labour Day, National Day for Truth and Reconciliation (30 September), Thanksgiving Day, Remembrance Day, Christmas Day and Boxing Day. Read from https://laws-lois.justice.gc.ca/eng/XML/L-2.xml.")
  (:title "Canada Labour Code s. 193(2)" :uri "https://laws-lois.justice.gc.ca/eng/acts/L-2/page-27.html"
   :text "When New Year's Day, Canada Day, NDTR, Remembrance Day, Christmas Day or Boxing Day falls on a non-working Saturday or Sunday, the employee gets the working day immediately preceding or following: no fixed calendar day, so not in this fixture.")
  (:title "Holidays Act (R.S.C. 1985, c. H-5) ss. 2-4" :uri "https://laws-lois.justice.gc.ca/eng/acts/H-5/"
   :text "s. 2: July 1, not being a Sunday, is Canada Day; when July 1 is a Sunday, July 2 is. s. 3: Remembrance Day, 11 November. s. 4: Victoria Day, the first Monday immediately preceding May 25.")
  (:title "Interpretation Act (R.S.C. 1985, c. I-21) s. 35(1), \"holiday\"" :uri "https://laws-lois.justice.gc.ca/eng/acts/I-21/"
   :text "Labour Day is the first Monday in September.")
  (:title "S.C. 2021, c. 11 (royal assent 2021-06-03)" :uri "https://laws-lois.justice.gc.ca/eng/AnnualStatutes/2021_11/"
   :text "Adds the National Day for Truth and Reconciliation, 30 September, from 2021.")
  (:title "Canada.ca, Annual vacations and general holidays for employees working for federally regulated employers" :uri "https://www.canada.ca/en/services/jobs/workplace/federal-labour-standards/vacations-holidays.html"
   :text "Lists the same 10 general holidays; a listed holiday on a non-working Saturday or Sunday gives a holiday with pay on the scheduled work day immediately before or after it.")
  (:title "Proclamation of 31 January 1957 (SOR/57-35)" :uri "https://www.canada.ca/en/canadian-heritage/services/important-commemorative-days.html"
   :text "Thanksgiving Day: the second Monday in October.")
 )
