;; Indonesia national holidays 2005-2040: external gold for ID.
;; Regenerate: uv run --no-project --with holidays==0.109 python -I scripts/generate_asia_holiday_gold.py ID
;; :days lists every holiday as (YEAR MONTH DAY NAME); any other day is not one.
(
 :country "ID"
 :generated "2026-11-27"
 :from 2005 :to 2040
 :note "Hari libur nasional as each year's SKB 3 Menteri (and amendments, and the election-day Keppres) set them, 2000-2027. Cuti bersama are not hari libur: they are listed under :cuti-bersama (the calendar with :cuti-bersama t). 2028-2040 are provisional: fixed and Easter days, moveable days estimated (perkiraan)."
 :sources
 (
  (:title "SKB 3 Menteri tentang Hari Libur Nasional dan Cuti Bersama, 2014-2027 (JDIH Kemnaker)" :uri "https://jdih.kemnaker.go.id/peraturan/detail/3089"
   :text "Keputusan Bersama Menteri Agama, Menteri Ketenagakerjaan dan Menteri PAN-RB of each year and every amending SKB (2020: four, 2021: two, 2022: two, 2023: two); e.g. SKB 1205/2026, 3/2026, 2/2026 (2026-09-15) for 2027. Lampiran I: hari libur nasional; lampiran II: cuti bersama.")
  (:title "SKB 3 Menteri 2005-2013 (menkokesra.go.id, depag.go.id / kemenag.go.id; Wayback copies)" :uri "https://www.kemenkopmk.go.id/index.php/node/6444"
   :text "E.g. SKB Menag No. 362/2004, Menakertrans KEP.119/MEN/VII/2004 (2005); No. 1/2009 (2010).")
  (:title "Keputusan Presiden: hari pemungutan suara sebagai hari libur nasional" :uri "https://web.archive.org/web/20250413192447/https://peraturan.bpk.go.id/Details/55580/keppres-no-26-tahun-2004"
   :text "Pemilu 2009, 2014, 2019, 2024 (Keppres 10/2024); Pilkada serentak 2015, 2017, 2018, 2020, 2024 (Keppres 33/2024).")
  (:title "Keppres No. 19/2002 (Imlek, from 2003); Keppres No. 24/2013 (Hari Buruh, from 2014); Keppres No. 24/2016 (Hari Lahir Pancasila, from 2017); Keppres No. 8/2024 (Kebangkitan Yesus Kristus)" :uri "https://setkab.go.id/pemerintah-tetapkan-hari-libur-nasional-dan-cuti-bersama-tahun-2025/"
   :text "The fixed days of the starter's rules and their first years.")
 )
