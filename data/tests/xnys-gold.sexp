;; XNYS gold, 1953-2030 (egao1980/cl-stack-calendars #11, #50). Regenerate:
;;   uv run --no-project --with exchange_calendars==4.13.3 python -I scripts/generate_xnys_gold.py
;; 1953-1969: the NYSE's own record (scripts/xnys/nyse_record.py), every row with its
;; source URL. 1970-2030: Python exchange_calendars XNYS (dates and close times).
;; :closed = weekdays that are not sessions; every other weekday is one.
;; :hours = regular hours by era (NYSE record); a session's close is its early close,
;; its open its late open, when it has one.
(
 :generated "2026-11-28"
 :sources (
   (:id "nyse-record" :from (1953 1 1) :to (1969 12 31) :uri "https://web.archive.org/web/20111110074209/http://www.nyse.com/pdfs/closings.pdf"
    :note "Saturday sessions ended in 1952 (summer closings from May 31, five-day week from Sept. 29). Before 1953 the NYSE list records Saturday closings only as it chose to (summer Saturdays, wartime) and has at least one wrong date in that era ('Dec. 12, 1950 (Sat) Saturday before Christmas Eve': Dec 12 1950 is a Tuesday), with no independent check, so earlier years are not modeled.")
   (:id "exchange_calendars" :calendar "XNYS" :version "4.13.3" :license "Apache-2.0" :from (1970 1 1) :to (2030 12 31) :uri "https://github.com/gerrymanoim/exchange_calendars"))
 :saturday-policy (:from (1959 7 3) :note "Before 1970 only the yearly exception applies: Friday Dec 31 1965 traded, but the NYSE's transactions for Friday May 29 1964 (Memorial Day on Saturday, the last weekday of May) read 'Holiday' (CFC 1964-06-01 p. 36). Before the policy a Saturday holiday closed no weekday: Fridays May 29 1953 (917,560 shares, CFC 1953-06-01 p. 33) and May 29 1959 (CFC 1959-06-01 p. 36) traded.")
 :from (1953 1 1) :to (2030 12 31) :session-count 19628
 :hours (
   ((1952 9 29) (1969 1 1) (10 0) (15 30) "https://web.archive.org/web/20240707144708/https://www.sechistorical.org/collection/papers/1960/1963_SSMkt_Chapter_06_2.pdf#page=6" "NYSE timeline 1952: 10 A.M. to 3:30 P.M. Monday-Friday; Special Study (1963): 5 1/2 hours")
   ((1969 1 2) (1969 7 3) (10 0) (14 0) "https://web.archive.org/web/20111110074209/http://www.nyse.com/pdfs/closings.pdf" "Jan. 2-July 3, 1969: five day week resumed, but with curtailed hours: 2:00 pm closing")
   ((1969 7 7) (1969 9 26) (10 0) (14 30) "https://web.archive.org/web/20111110074209/http://www.nyse.com/pdfs/closings.pdf" "July 7-Sept. 26, 1969: 2:30 pm closing - Paperwork Crisis")
   ((1969 9 29) (1970 5 1) (10 0) (15 0) "https://web.archive.org/web/20111110074209/http://www.nyse.com/pdfs/closings.pdf" "Sept. 29, 1969-May 1, 1970: 3:00 pm closing. Normal hours (10:00 am-3:30 pm) resumed May 4, 1970")
   ((1970 5 4) (1974 9 30) (10 0) (15 30) "https://web.archive.org/web/20111110074209/http://www.nyse.com/pdfs/closings.pdf" "Normal hours (10:00 am-3:30 pm) resumed May 4, 1970")
   ((1974 10 1) (1985 9 27) (10 0) (16 0) "https://web.archive.org/web/20100507135343/http://www.nyse.com/about/history/timeline_trading.html" "NYSE timeline 1974: trading hours are extended from 10 a.m. until 4 p.m. (the timeline gives the year; the first day, Oct. 1, is the date cl-stack-calendars has carried since 0.5.0)")
   ((1985 9 30) nil (9 30) (16 0) "https://web.archive.org/web/20100507135343/http://www.nyse.com/about/history/timeline_trading.html" "NYSE timeline 1985: trading hours change to 9:30 a.m. until 4 p.m. (first day Sept. 30, 1985, the Monday after the Hurricane Gloria closing)")
 )
