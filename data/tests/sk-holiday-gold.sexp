;; Slovakia public holidays 2000-2040: external gold for SK.
;; Regenerate: uv run --no-project --with holidays==0.109 python -I scripts/generate_mena_holiday_gold.py SK
;; :days lists every holiday as (YEAR MONTH DAY NAME); any other day is not one.
(
 :country "SK"
 :generated "2026-11-28"
 :from 2000 :to 2040
 :note "Dni pracovného pokoja of Slovakia: zákon 241/1993 Z. z. § 2 as amended: 17 November from 15 Nov 2001 (442/2001) to 31 Oct 2025 (261/2025), 1 September to 2023 (530/2023), 28 October never a day of rest, 30 October 2018 (§ 4a), no 8 May and 15 September in 2026 (§ 4b)."
 :weekends ((nil 6 7))
 :sources
 (
  (:title "Zákon č. 241/1993 Z. z. o štátnych sviatkoch, dňoch pracovného pokoja a pamätných dňoch" :uri "https://static.slov-lex.sk/static/SK/ZZ/1993/241/20001128.html"
   :text "§ 1 state holidays (1 Jan, 5 Jul, 29 Aug, 1 Sep) and § 2 days of rest: 6 Jan, Good Friday, Easter Monday, 1 May, 8 May, 15 Sep, 1 Nov, 24-26 Dec.")
  (:title "Zákon č. 442/2001 Z. z. (17. november)" :uri "https://static.slov-lex.sk/static/SK/ZZ/2001/442/20011115.html"
   :text "Čl. I: § 1 e) 17. november – Deň boja za slobodu a demokraciu (a state holiday and so a day of rest). Čl. II: účinnosť 15. novembra 2001.")
  (:title "Zákon č. 281/2018 Z. z. (§ 4a, 30. október 2018)" :uri "https://static.slov-lex.sk/static/SK/ZZ/2018/281/20181011.html"
   :text "§ 4a: V roku 2018 je 30. október – výročie Deklarácie slovenského národa štátnym sviatkom.")
  (:title "Zákon č. 530/2023 Z. z., čl. III" :uri "https://static.slov-lex.sk/static/SK/ZZ/2023/530/20240101.html"
   :text "Čl. III: § 2 ods. 3 also excludes § 1 písm. d) (1 September) from the days of rest.")
  (:title "Zákon č. 261/2025 Z. z., čl. IV" :uri "https://static.slov-lex.sk/static/SK/ZZ/2025/261/20251101.html"
   :text "Čl. IV: § 2 ods. 3 excludes § 1 písm. d), e) and f) (17 November) from the days of rest; § 4b: V roku 2026 nie sú sviatky uvedené v § 2 ods. 2 písm. e) a j) (15 September, 8 May) dňami pracovného pokoja.")
 )
