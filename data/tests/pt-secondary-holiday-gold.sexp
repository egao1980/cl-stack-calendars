;; Portugal (secondary sources) public holidays 2000-2008: external gold for PT.
;; Regenerate: uv run --no-project --with holidays==0.109 python -I scripts/generate_mena_holiday_gold.py PT-SECONDARY
;; :days lists every holiday as (YEAR MONTH DAY NAME); any other day is not one.
(
 :country "PT"
 :generated "2026-11-28"
 :from 2000 :to 2008
 :note "LOWER CONFIDENCE. 2000-2008: the Código do Trabalho 2003 (art. 208.º) and DL 874/76 lists were not read; the art. 234.º days of 2009, which python-holidays agrees with."
 :confidence :secondary
 :weekends ((nil 6 7))
 :sources
 (
  (:title "Lei n.º 7/2009, de 12 de fevereiro (Código do Trabalho), art. 234.º" :uri "https://diariodarepublica.pt/dr/detalhe/lei/7-2009-602073"
   :text "Art. 234.º(1): São feriados obrigatórios os dias 1 de Janeiro, de Sexta-Feira Santa, de Domingo de Páscoa, 25 de Abril, 1 de Maio, de Corpo de Deus, 10 de Junho, 15 de Agosto, 5 de Outubro, 1 de Novembro, 1, 8 e 25 de Dezembro.")
  (:title "Lei n.º 23/2012, de 25 de junho (terceira alteração ao Código do Trabalho)" :uri "https://diariodarepublica.pt/dr/detalhe/lei/23-2012-178501"
   :text "Art. 234.º(1) reduced to 1 de janeiro, Sexta-Feira Santa, Domingo de Páscoa, 25 de abril, 1 de maio, 10 de junho, 15 de agosto, 8 e 25 de dezembro: Corpo de Deus, 5 de outubro, 1 de novembro and 1 de dezembro are not feriados in 2013-2015.")
  (:title "Lei n.º 8/2016, de 1 de abril (décima alteração ao Código do Trabalho, restabelecendo feriados nacionais)" :uri "https://diariodarepublica.pt/dr/detalhe/lei/8-2016-74007209"
   :text "Restores Corpo de Deus, 5 de outubro, 1 de novembro and 1 de dezembro in art. 234.º(1).")
 )
