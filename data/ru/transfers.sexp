              ((2025 2 23) (2025 5 8) "с 23 февраля на 8 мая")
              ((2025 3 8) (2025 6 13) "с 8 марта на 13 июня")
              ((2025 11 1) (2025 11 3) "с 1 ноября на 3 ноября")))

