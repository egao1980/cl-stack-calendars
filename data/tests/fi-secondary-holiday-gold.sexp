 :sources
 (
  (:title "Kirkkolaki 1054/1993, 4 luku 3 § (kirkolliset juhlapäivät)" :uri "http://data.finlex.fi/eli/sd/1993/1054/alkup"
   :text "Kirkollisia juhlapäiviä ovat joulupäivä, toinen joulupäivä, uudenvuodenpäivä, loppiainen, pitkäperjantai, pääsiäispäivä, toinen pääsiäispäivä, helatorstai, helluntai, juhannuspäivä ja pyhäinpäivä; juhannuspäivä the Saturday after 19 June, pyhäinpäivä the Saturday after 30 October.")
  (:title "Kirkkolaki 652/2023, 1 luku 6 §" :uri "http://data.finlex.fi/eli/sd/2023/652/ajantasa"
   :text "The same eleven kirkolliset juhlapäivät; repeals 1054/1993.")
  (:title "Laki itsenäisyyspäivän viettämisestä yleisenä juhla- ja vapaapäivänä 388/1937" :uri "http://data.finlex.fi/eli/sd/1937/388/ajantasa"
   :text "1 §: joulukuun kuudetta päivää ... vuosittain vietettävä yleisenä juhla- ja vapaapäivänä.")
  (:title "Vuosilomalaki 162/2005, 4 § 3 kohta" :uri "http://data.finlex.fi/eli/sd/2005/162/alkup"
   :text "arkipäivällä muita viikonpäiviä kuin sunnuntaita, kirkollisia juhlapäiviä, itsenäisyyspäivää, jouluaattoa, juhannusaattoa, pääsiäislauantaita ja vapunpäivää.")
 )
