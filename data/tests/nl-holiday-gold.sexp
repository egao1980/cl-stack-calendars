;; Regenerate: uv run --no-project --with holidays==0.109 python -I scripts/generate_mena_holiday_gold.py NL
;; :days lists every holiday as (YEAR MONTH DAY NAME); any other day is not one.
(
 :country "NL"
 :generated "2026-11-28"
 :from 2000 :to 2040
 :note "Algemeen erkende feestdagen of the Netherlands: Algemene termijnenwet art. 3(1) (Nieuwjaarsdag, tweede Paas- en Pinksterdag, Hemelvaartsdag, both Christmas days, 5 May every year, the King's/Queen's birthday): Koninginnedag 30 April, on a Sunday the Saturday before (KB 24 april 1980 nr. 11) to 2013; Koningsdag 27 April, on a Sunday 26 April, from 2014 (Besluit van 30 januari 2013, Stcrt. 2013, 4075). Goede Vrijdag is only equated for time limits (art. 3(2))."
 :weekends ((nil 6 7))
 :sources
 (
  (:title "Algemene termijnenwet (wet van 5 juni 1964, Stb. 1964, 314), art. 3, as amended by Stb. 1982, 70" :uri "https://wetten.overheid.nl/BWBR0002448/2010-10-10"
   :text "Art. 3(1): algemeen erkende feestdagen are de Nieuwjaarsdag, de Christelijke tweede Paas- en Pinksterdag, de beide Kerstdagen, de Hemelvaartsdag, de dag waarop de verjaardag van de Koning wordt gevierd en de vijfde mei. Art. 3(2): Goede Vrijdag is equated for this Act only.")
  (:title "Koninklijk besluit van 24 april 1980, nr. 11 (Koninginnedag, 30 april)" :uri "https://zoek.officielebekendmakingen.nl/stcrt-2013-4075.html"
   :text "Koninginnedag on 30 April; on a Sunday it is celebrated on the Saturday before.")
 )
