;; Sweden public holidays 2000-2040: external gold for SE.
;; Regenerate: uv run --no-project --with holidays==0.109 python -I scripts/generate_mena_holiday_gold.py SE
;; :days lists every holiday as (YEAR MONTH DAY NAME); any other day is not one.
(
 :country "SE"
 :generated "2026-11-28"
 :from 2000 :to 2040
 :note "Allmänna helgdagar of Sweden: Lag (1989:253) 1-2 § (påskdagen and pingstdagen named; other Sundays not listed), annandag pingst to 2004 and nationaldagen from 2005 (SFS 2004:1320, in force 1 Apr 2005). The eves are no allmänna helgdagar."
 :weekends ((nil 6 7))
 :sources
 (
  (:title "Lag (1989:253) om allmänna helgdagar" :uri "https://www.riksdagen.se/sv/dokument-och-lagar/dokument/svensk-forfattningssamling/lag-1989253-om-allmanna-helgdagar_sfs-1989-253/"
   :text "1 §: söndagar, däribland påskdagen och pingstdagen, nyårsdagen, trettondedag jul, första maj, juldagen och annandag jul, långfredagen, annandag påsk, Kristi himmelsfärdsdag, (annandag pingst to 2004), nationaldagen, midsommardagen och alla helgons dag. 2 §: midsommardagen the Saturday 20-26 June, alla helgons dag the Saturday 31 October-6 November.")
  (:title "Lag (2004:1320) om ändring i lagen (1989:253) om allmänna helgdagar" :uri "https://rkrattsdb.gov.se/SFSdoc/04/041320.PDF"
   :text "Nationaldagen den 6 juni becomes an allmän helgdag; annandag pingst ceases to be one (prop. 2004/05:23). Denna lag träder i kraft den 1 april 2005.")
 )
