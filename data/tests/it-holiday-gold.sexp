;; Italy public holidays 2000-2040: external gold for IT.
;; Regenerate: uv run --no-project --with holidays==0.109 python -I scripts/generate_mena_holiday_gold.py IT
;; :days lists every holiday as (YEAR MONTH DAY NAME); any other day is not one.
(
 :country "IT"
 :generated "2026-11-28"
 :from 2000 :to 2040
 :note "Giorni festivi of Italy: L. 260/1949 art. 1-2 less the days L. 54/1977 suppressed (Epifania back from 1986, D.P.R. 792/1985), the festa nazionale on the first Sunday of June 1977-2000 and on 2 June again from 2001 (L. 336/2000), the festa dell'Unità nazionale on the first Sunday of November (L. 54/1977; L. 27/2024 gives 4 November no civil effects), San Francesco d'Assisi 4 October from 2026 (L. 151/2025) and 17 March 2011 (D.L. 5/2011). No weekend rule."
 :weekends ((nil 6 7))
 :sources
 (
  (:title "Legge 27 maggio 1949, n. 260, Disposizioni in materia di ricorrenze festive" :uri "https://www.normattiva.it/uri-res/N2Ls?urn:nir:stato:legge:1949-05-27;260"
   :text "Art. 1: 2 giugno festa nazionale. Art. 2: giorni festivi: tutte le domeniche, 1 gennaio, Epifania, San Giuseppe, 25 aprile, lunedì dopo Pasqua, Ascensione, Corpus Domini, 1 maggio, SS. Pietro e Paolo, Assunzione, Ognissanti, 4 novembre, Immacolata, Natale, 26 dicembre.")
  (:title "Legge 5 marzo 1977, n. 54, Disposizioni in materia di giorni festivi" :uri "https://www.normattiva.it/uri-res/N2Ls?urn:nir:stato:legge:1977-03-05;54"
   :text "Art. 1: Epifania, San Giuseppe, Ascensione, Corpus Domini, SS. Pietro e Paolo cease to be festivi agli effetti civili; from 1977 the festa nazionale della Repubblica and the festa dell'Unità nazionale are celebrated on the first Sunday of June and of November; 2 giugno and 4 novembre cease to be festivi.")
  (:title "D.P.R. 28 dicembre 1985, n. 792 (festività religiose, accordo con la Santa Sede)" :uri "https://www.normattiva.it/uri-res/N2Ls?urn:nir:presidente.repubblica:decreto:1985-12-28;792"
   :text "Art. 1: festività religiose: tutte le domeniche, 1 gennaio, 6 gennaio (Epifania restored), 15 agosto, 1 novembre, 8 dicembre, 25 dicembre (29 giugno for Rome only).")
  (:title "Legge 20 novembre 2000, n. 336, Ripristino della festività nazionale del 2 giugno" :uri "https://www.normattiva.it/uri-res/N2Ls?urn:nir:stato:legge:2000-11-20;336"
   :text "Art. 1: from 2001 the festa nazionale della Repubblica is again celebrated on 2 June, restored as a giorno festivo. So 2000-06-02 (a Friday) was a working day; the 2000 festa was Sunday 4 June.")
  (:title "Decreto-legge 22 febbraio 2011, n. 5, Disposizioni per la festa nazionale del 17 marzo 2011 (convertito dalla L. 21 aprile 2011, n. 47)" :uri "https://www.normattiva.it/uri-res/N2Ls?urn:nir:stato:decreto.legge:2011-02-22;5"
   :text "Art. 1(1): limitatamente all'anno 2011, il giorno 17 marzo è considerato giorno festivo ai sensi degli articoli 2 e 4 della legge 27 maggio 1949, n. 260 (150th anniversary of unification).")
  (:title "Legge 1 marzo 2024, n. 27, Istituzione della Giornata dell'Unità nazionale e delle Forze armate" :uri "https://www.normattiva.it/uri-res/N2Ls?urn:nir:stato:legge:2024-03-01;27"
   :text "Art. 1: 4 November is the Giornata dell'Unità nazionale e delle Forze armate; it does not have the civil effects of L. 260/1949 (no day off). Recorded to show 4 November stays a working day.")
  (:title "Legge 8 ottobre 2025, n. 151, Istituzione della festa nazionale di San Francesco d'Assisi" :uri "https://www.normattiva.it/uri-res/N2Ls?urn:nir:stato:legge:2025-10-08;151"
   :text "Art. 1(2) inserts in L. 260/1949 art. 2: 'il 4 ottobre: festa nazionale di San Francesco d'Assisi, patrono d'Italia'. In force 1 January 2026.")
 )
