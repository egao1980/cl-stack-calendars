(
 :country "CZ"
 :generated "2026-11-28"
 :from 2000 :to 2040
 :note "Dny pracovního klidu of Czechia: zákon 245/2000 Sb. § 1-3 (in force 9 Aug 2000; before it 93/1951 Sb. and 204/1990 Sb.), Velký pátek from 2016 (359/2015 Sb.)."
 :weekends ((nil 6 7))
 :sources
 (
  (:title "Zákon č. 93/1951 Sb., o státním svátku, o dnech pracovního klidu a o památných a významných dnech (ve znění do 8. 8. 2000); zákon ČNR č. 204/1990 Sb. (6. července)" :uri "https://www.e-sbirka.cz/sb/1951/93"
   :text "§ 1: 8 May, 5 Jul, 28 Oct; 204/1990: 6 Jul; § 2(2): 1 Jan, Easter Monday, 1 May, 24-26 Dec.")
  (:title "Zákon č. 245/2000 Sb., o státních svátcích, o ostatních svátcích, o významných dnech a o dnech pracovního klidu" :uri "https://www.e-sbirka.cz/sb/2000/245"
   :text "§ 1: 1 Jan, 8 May, 5 Jul, 6 Jul, 28 Sep, 28 Oct, 17 Nov státní svátky; § 2: 1 Jan, Easter Monday, 1 May, 24-26 Dec ostatní svátky; § 3: both are dny pracovního klidu. Nabývá účinnosti dnem vyhlášení.")
  (:title "Zákon č. 359/2015 Sb., kterým se mění zákon č. 245/2000 Sb. (Velký pátek)" :uri "https://www.e-sbirka.cz/eli/cz/sb/2015/359/2015-12-21"
   :text "Čl. I: § 2 gains »Velký pátek«; first day off 25 Mar 2016.")
